{
  "name": "dsh-recall",
  "version": "0.3.0",
  "description": "Move big tool results out of the conversation to disk, keep their head inline, and let the model pull the rest back with recall(id). A strip under the composer shows what was offloaded and how often it was needed.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/reaper.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README-RU.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-recall",
    "summary": "Big tool results keep only their first 600 characters in the conversation; the rest goes to disk under an object id the model can pull back with recall(id). A strip under the composer reports how much was offloaded, how many tokens that kept out of the context, and how often the model actually went back for more.",
    "categories": [
      "Context",
      "Cost",
      "Web UI",
      "Observability"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "tool:recall"
      ],
      "hooks": [
        "tools/post-execute"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-0",
      "node": ">=20"
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context",
    "compaction",
    "offload",
    "recall",
    "tokens",
    "cost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sh-222/dsh-recall.git"
  },
  "homepage": "https://github.com/sh-222/dsh-recall#readme",
  "bugs": {
    "url": "https://github.com/sh-222/dsh-recall/issues"
  },
  "author": "sh-222",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
